NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j
FRONTEND_ORIGIN=http://localhost:5173
AI_PROVIDER=tabnine_cli
# For offline document extraction without AI credentials, use AI_PROVIDER=local_rules.
TABNINE_CLI_PATH=tabnine
TABNINE_TIMEOUT_SECONDS=60
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.db
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_CHUNK_CHARS=6000
MAX_CHUNKS_PER_DOCUMENT=20
ENTITY_RESOLUTION_AUTO_MATCH_THRESHOLD=0.9
ENTITY_RESOLUTION_MAX_CANDIDATES=5
